{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@hl-agents/core": ["./packages/core/src/index.ts"],
      "@hl-agents/validate": ["./packages/validate/src/index.ts"],
      "@hl-agents/review-adapters": ["./packages/review-adapters/src/index.ts"],
      "@hl-agents/fix-adapters": ["./packages/fix-adapters/src/index.ts"],
      "@hl-agents/committer": ["./packages/committer/src/index.ts"],
      "@hl-agents/cli": ["./packages/cli/src/index.ts"],
      "@hl-agents/opencode-agent": ["./packages/opencode-agent/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}